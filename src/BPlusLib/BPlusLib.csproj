<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net481;netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BPlusLib</AssemblyName>
    <RootNamespace>BPlusLib</RootNamespace>
    <Description>BPlusLib — Multi-purpose Windows utility library: SerialPortInspector, MessageBoxEx, Utils, and more.</Description>
    <Version>1.0.0</Version>
    <Authors>thanhbinhqs</Authors>
    <Company>thanhbinhqs</Company>
    <PackageId>BPlusLib</PackageId>
    <PackageProjectUrl>https://github.com/thanhbinhqs/BPlusLib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thanhbinhqs/BPlusLib.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>serial-port;com-port;nt-api;win32;pinvoke;messagebox;utils</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
    <Features>strict</Features>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="1.1.1" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>