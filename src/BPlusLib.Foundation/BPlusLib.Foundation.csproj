<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net6.0;net8.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BPlusLib.Foundation</AssemblyName>
    <RootNamespace>BPlusLib.Foundation</RootNamespace>
    <Description>BPlusLib.Foundation — Enterprise-grade Windows Foundation Library: 28 modules, 1164+ tests. Serial port inspection, service management, security/UAC, IPC (TCP/UDP/Pipes), system info, process tools, shell integration, cryptography, power management, input simulation, and more. Pure P/Invoke — no WMI, no PowerShell.</Description>
    <Version>2.8.0</Version>
    <Authors>thanhbinhqs</Authors>
    <Company>thanhbinhqs</Company>
    <PackageId>BPlusLib.Foundation</PackageId>
    <PackageProjectUrl>https://github.com/thanhbinhqs/BPlusLib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thanhbinhqs/BPlusLib.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>windows;foundation;pinvoke;serialport;service;security;uac;credential;wintrust;tcp;udp;pipe;named-pipe;process;system-info;registry;diagnostics;logging;clipboard;explorer;cryptography;media;graphics;display;dpi;shell;theme;dark-mode;device;localization;threading;console;job-object;hotkey;input;power;hibernate;http;ftp;http-listener</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
    <Features>strict</Features>
    <NoWarn>$(NoWarn);CS1591;CA1416;CS8625;CS8600;CS8601;CS8602;CS8604;CS0649;CS8777;CS1587;CS1574</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="&#39;$(TargetFramework)&#39; == &#39;net472&#39; or &#39;$(TargetFramework)&#39; == &#39;net6.0&#39;">
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="1.1.1" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

  <!-- System.Diagnostics.EventLog for EventLogReader modern path -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <PackageReference Include="System.Diagnostics.EventLog" Version="6.0.0" />
  </ItemGroup>
   <ItemGroup>
     <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
   </ItemGroup>

   <ItemGroup>
     <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
       <_Parameter1>BPlusLib.Foundation.Tests</_Parameter1>
     </AssemblyAttribute>
   </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Windows-only: WinForms support for the Window module -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);FEATURE_WINDOW_MODULE</DefineConstants>
  </PropertyGroup>

</Project>