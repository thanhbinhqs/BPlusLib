<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <SupportedOSPlatform>Windows</SupportedOSPlatform>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);FEATURE_WINDOW_MODULE</DefineConstants>
    <AssemblyName>BPlusLib.Foundation</AssemblyName>
    <RootNamespace>BPlusLib.Foundation</RootNamespace>
    <Description>BPlusLib.Foundation — Enterprise-grade Windows-only foundation library for .NET 8/10 desktop apps: WinForms, WPF, pure P/Invoke. Serial port inspection, service management, security/UAC, IPC (TCP/UDP/Pipes), system info, process tools, shell integration, cryptography, power management, input simulation, and more.</Description>
    <Version>2.12.2</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>thanhbinhqs</Authors>
    <Company>thanhbinhqs</Company>
    <PackageId>BPlusLib.Foundation</PackageId>
    <PackageProjectUrl>https://github.com/thanhbinhqs/BPlusLib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thanhbinhqs/BPlusLib.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>windows;winforms;wpf;net8;net10;foundation;pinvoke;serialport;service;security;uac;credential;wintrust;tcp;udp;pipe;named-pipe;process;system-info;registry;diagnostics;logging;clipboard;explorer;cryptography;media;graphics;display;dpi;shell;theme;dark-mode;device;localization;threading;console;job-object;hotkey;input;power;hibernate;http;ftp;http-listener</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
    <Features>strict</Features>
    <NoWarn>$(NoWarn);CS1591;CA1416;CS8625;CS8600;CS8601;CS8602;CS8604;CS0649;CS8777;CS1587;CS1574</NoWarn>
  </PropertyGroup>

  <!-- Modern Windows desktop/runtime dependencies -->
  <ItemGroup>
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.0" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
  </ItemGroup>
   <ItemGroup>
     <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="5.3.4" />
   </ItemGroup>

   <ItemGroup>
     <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
       <_Parameter1>BPlusLib.Foundation.Tests</_Parameter1>
     </AssemblyAttribute>
   </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>